<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f8f7f4">
    <meta name="description" content="Sign in to manage a Dapper stylist profile.">
    <title>Stylist sign in — Dapper</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <%- include('partials/header', { currentPage: 'login' }) %>
    <main class="content-page login-page">
        <section class="page-intro">
            <p class="section-kicker">STYLIST STUDIO</p>
            <h1>Your profile, <em>your space.</em></h1>
            <p>Sign in to manage stylist information.</p>
        </section>
        <section class="editor-card login-card" aria-labelledby="login-title">
            <h2 id="login-title">Stylist sign in</h2>
            <% if (loginConfigured) { %>
                <p class="application-intro">Use the shared editor passphrase configured by the site owner.</p>
                <% if (loginError) { %><p class="form-error login-error" role="alert"><%= loginError %></p><% } %>
                <form action="/auth/login" method="post">
                    <label class="form-label">Editor passphrase<input name="password" type="password" minlength="16" maxlength="256" autocomplete="current-password" required></label>
                    <button class="button button-dark" type="submit">Sign in <span>↗</span></button>
                </form>
            <% } else { %>
                <div class="demo-notice" role="status">
                    <strong>Stylist editing is locked</strong>
                    <span>The site owner must set <code>STYLIST_EDITOR_PASSWORD</code> to a passphrase of at least 16 characters before profile editing is available.</span>
                </div>
            <% } %>
        </section>
    </main>
    <%- include('partials/footer') %>
</body>
</html>
