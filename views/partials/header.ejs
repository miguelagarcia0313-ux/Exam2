<header class="site-header">
    <a class="wordmark" href="/" aria-label="Dapper home">dapper<span>.</span></a>
    <nav class="main-nav" aria-label="Main navigation">
        <a class="nav-link <%= currentPage === 'home' ? 'active' : '' %>" href="/#discover">Find a stylist</a>
        <a class="nav-link" href="/#how-it-works">How it works</a>
        <a class="nav-link <%= currentPage === 'become' ? 'active' : '' %>" href="/become-a-stylist">For stylists</a>
    </nav>
    <div class="header-actions">
        <% if (currentPage === 'home') { %>
            <button class="text-button" id="my-bookings" type="button">My bookings</button>
            <a class="avatar-button" href="<%= isStylistAuthenticated ? '/stylist/profile' : '/stylist/login' %>" aria-label="<%= isStylistAuthenticated ? 'Open stylist profile' : 'Sign in to manage stylist profile' %>" title="<%= isStylistAuthenticated ? 'Open stylist profile' : 'Stylist sign in' %>">M</a>
        <% } else if (isStylistAuthenticated) { %>
            <a class="text-button text-button-link" href="/stylist/profile">My profile</a>
            <form class="logout-form" action="/auth/logout" method="post">
                <button class="text-button" type="submit">Sign out</button>
            </form>
        <% } else { %>
            <a class="text-button text-button-link" href="/stylist/login">Stylist sign in</a>
        <% } %>
        <button class="mobile-menu" id="mobile-menu" type="button" aria-label="Open menu"><span></span><span></span></button>
    </div>
</header>
